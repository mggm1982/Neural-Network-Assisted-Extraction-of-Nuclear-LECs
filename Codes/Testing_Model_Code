rt numpy as np\n","import pandas as pd\n","import multiprocessing as mp\n","from numpy.polynomial.legendre import leggauss          # was missing before -> NameError on a fresh run\n","from scipy.linalg import solve\n","from scipy.optimize import least_squares\n","from sympy.physics.quantum.cg import CG\n","from sympy import S as Sy\n","import matplotlib.pyplot as plt\n","from tqdm.auto import tqdm\n","\n","try:                                                     # Colab: use Google Drive\n","    from google.colab import drive\n","    drive.mount('/content/drive')\n","    BASE_DIR = '/content/drive/MyDrive/PHC_351_Project'\n","except ImportError:                                      # local machine\n","    BASE_DIR = './PHC_351_Project'\n","\n","TRAIN_DIR, TEST_DIR = f'{BASE_DIR}/Training_Data', f'{BASE_DIR}/Testing_Data'\n","CODE_DIR = f'{BASE_DIR}/Codes'\n","for d in (TRAIN_DIR, TEST_DIR, CODE_DIR):\n","    os.makedirs(d, exist_ok=True)\n","SEED = 42\n","plt.rcParams.update({'axes.spines.top': False, 'axes.spines.right': False, 'axes.grid': True,\n","                     'grid.alpha': 0.3, 'axes.titleweight': 'bold', 'legend.frameon': False})"],"metadata":{"id":"ue1HfOx4TGeK","colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"status":"ok","timestamp":1792942992124,"user_tz":-330,"elapsed":30159,"user":{"displayName":"GAUTAM BALASUBRAMANIAN 24123013","userId":"06147752629034690759"}},"outputId":"901b56c4-80d8-4a03-e7fe-b0825613be11"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["Mounted at /content/drive\n"]}]},{"cell_type":"code","source":["UNC_WAVES = ['1S0', '3S1', '1P1', '3P0', '3P1', '3P2']\n","LEC_NAMES = ['C_tilde_1S0', 'C_1S0', 'C_tilde_3S1', 'C_3S1', 'C_1P1', 'C_3P0', 'C_3P1', 'C_3P2']\n","WAVE_LECS = {'1S0': ['C_tilde_1S0', 'C_1S0'], '3S1': ['C_tilde_3S1', 'C_3S1'], '1P1': ['C_1P1'],\n","             '3P0': ['C_3P0'], '3P1': ['C_3P1'], '3P2': ['C_3P2']}\n","\n","LEC_RANGE = {'C_tilde_1S0': (-1.5, 1.5), 'C_1S0': (-6.0, 6.0), 'C_tilde_3S1': (-1.5, 1.5), 'C_3S1': (-6.0, 6.0),\n","             'C_1P1': (-3.0, 3.0), 'C_3P0': (-3.0, 3.0), 'C_3P1': (-3.0, 3.0), 'C_3P2': (-3.0, 3.0)}\n","\n","LEC_LABELS = [r'$\\widetilde{C}_{1S0}$', r'$C_{1S0}$', r'$\\widetilde{C}_{3S1}$', r'$C_{3S1}$',\n","              r'$C_{1P1}$', r'$C_{3P0}$', r'$C_{3P1}$', r'$C_{3P2}$']\n","\n","ENERGIES = np.array([1, 5, 10, 40, 70, 100, 130, 160, 190, 220, 250, 280, 300])\n","FEAT_ENERGIES = np.array([10, 40, 70, 100, 130, 160, 190, 220, 250, 280, 300])\n","FEAT_IDX = [int(np.where(ENERGIES == e)[0][0]) for e in FEAT_ENERGIES]\n","FEAT_COLS = [f'{w}_{int(E)}MeV' for w in UNC_WAVES for E in FEAT_ENERGIES]\n","\n","NIJ = {   # experimental phase shift from nn.online\n","    '1S0': [59.96, 44.23, 34.31, 26.78, 20.58, 15.23, 10.44, 6.06, 1.96, -1.94, -4.46],\n","    '3S1': [102.61, 68.67, 53.53, 43.22747, 35.24, 28.64, 22.96, 17.93, 13.39, 9.22, 6.6],\n","    '1P1': [-3.04, -8.49, -11.75, -14.52, -17.06, -19.4, -21.52, -23.43, -25.134, -26.66, -27.58],\n","    '3P0': [3.65277, 10.20197, 10.44121, 8.45567, 5.68936, 2.66414, -0.41901, -3.48465, -6.51063, -9.49824, -11.47402],\n","    '3P1': [-2.06382, -7.03052, -10.40627, -13.23811, -15.82157, -18.25170, -20.56023, -22.75675, -24.8, -26.81675, -28.06943],\n","    '3P2': [0.70730, 4.5872, 8.21281, 10.94293, 12.88315, 14.24366, 15.20280, 15.88871, 16.38822, 16.75887, 16.95363]}\n","\n","wrap = lambda d: (d + 90.0) % 180.0 - 90.0     # wraps back around after 180\n","\n","# test row in the same column order as the training data (LEC columns are dummies = 0)\n","row = {n: 0.0 for n in LEC_NAMES}\n","row.update({f'{w}_{int(E)}MeV': NIJ[w][i] for w in UNC_WAVES for i, E in enumerate(FEAT_ENERGIES)})\n","df_nij = pd.DataFrame([row])\n","df_nij.to_csv(f'{TEST_DIR}/nijmegen_test_ready.csv', index=False)\n","print(f'Nijmegen test row: {df_nij.shape[1]} columns  ->  {TEST_DIR}/nijmegen_test_ready.csv')"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"QeCIri7ZxVXL","executionInfo":{"status":"ok","timestamp":1792926934760,"user_tz":-330,"elapsed":1188,"user":{"displayName":"GAUTAM BALASUBRAMANIAN 24123013","userId":"06147752629034690759"}},"outputId":"4bce53f7-b91e-4662-d09b-57e245624737"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["Nijmegen test row: 74 columns  ->  /content/drive/MyDrive/PHC_351_Project/Testing_Data/nijmegen_test_ready.csv\n"]}]},{"cell_type":"code","source":["LAMBDA_CUTOFF = 500.0\n","M_PION, M_NUCLEON, G_A, F_PI = 138.0, 938.92, 1.29, 92.4\n","TPI3 = (2 * np.pi) ** 3\n","\n","def regulator(p, q, n, Lambda=None):\n","    if Lambda is None:\n","        Lambda = LAMBDA_CUTOFF\n","    return np.exp(-((p / Lambda) ** (2 * n) + (q / Lambda) ** (2 * n)))\n","\n","def get_fixed_grid(n_points=48, scale_c=300.0):\n","    x, w_x = leggauss(n_points)\n","    q_grid = scale_c * (1 + x) / (1 - x)\n","    w_q = w_x * (2 * scale_c) / (1 - x) ** 2\n","    return q_grid, w_q\n","\n","Q_GRID, W_Q = get_fixed_grid()\n","WAVE_QN = {'1S0': (0, 0, 0, 1), '3S1': (0, 1, 1, 0), '1P1': (1, 0, 1, 0),      # (l, S, J, T)\n","           '3P0': (1, 1, 0, 1), '3P1': (1, 1, 1, 1), '3P2': (1, 1, 2, 1)}\n","\n","\n","_sx = np.array([[0, 1], [1, 0]], complex)\n","_sz = np.array([[1, 0], [0, -1]], complex)\n","_U = np.zeros((4, 4), complex)\n","_U[0, 0] = 1; _U[1, 1] = _U[2, 1] = 1 / np.sqrt(2); _U[3, 2] = 1; _U[1, 3], _U[2, 3] = 1 / np.sqrt(2), -1 / np.sqrt(2)\n","\n","def _Y(l, m, th):\n","    if l == 0:\n","        return np.full_like(th, 1 / np.sqrt(4 * np.pi))\n","    return {0: np.sqrt(3 / (4 * np.pi)) * np.cos(th), 1: -np.sqrt(3 / (8 * np.pi)) * np.sin(th),\n","            -1: np.sqrt(3 / (8 * np.pi)) * np.sin(th)}[m]\n","\n","def _cg(j1, m1, j2, m2, J, M):\n","    return float(CG(Sy(j1), Sy(m1), Sy(j2), Sy(m2), Sy(J), Sy(M)).doit())\n","\n","def _sidx(S, ms):\n","    return 3 if S == 0 else {1: 0, 0: 1, -1: 2}[ms]\n","\n","def calculate_pion_exchanges(p, pp, wave, nz=64):\n","\n","    l, S, J, T = WAVE_QN[wave]\n","    tt = 1.0 if T == 1 else -3.0                          # tau1.tau2\n","    zx, zw = leggauss(nz); th = np.arccos(zx)\n","    Pm, PPm, Z = np.meshgrid(p, pp, zx, indexing='xy')\n","    qx = PPm * np.sin(th)[None, None, :] * np.ones_like(Pm); qz = PPm * Z - Pm\n","    q2 = qx ** 2 + qz ** 2\n","    sq = qx[..., None, None] * _sx + qz[..., None, None] * _sz\n","    O = np.einsum('...ab,...cd->...acbd', sq, sq).reshape(*sq.shape[:-2], 4, 4)\n","    Os = np.einsum('ia,...ij,jb->...ab', _U.conj(), O, _U)\n","    pref = -(G_A ** 2 / (4 * F_PI ** 2)) * tt / (q2 + M_PION ** 2)\n","    tot = np.zeros(Pm.shape, complex)\n","    for Mm in range(-J, J + 1):\n","        if abs(Mm) > S:\n","            continue\n","        for msp in range(-S, S + 1):\n","            mp_ = Mm - msp\n","            if abs(mp_) > l:\n","                continue\n","            c = _cg(l, mp_, S, msp, J, Mm) * _cg(l, 0, S, Mm, J, Mm)\n","            if c == 0:\n","                continue\n","            tot += c * _Y(l, mp_, th)[None, None, :] * np.sqrt((2 * l + 1) / (4 * np.pi)) \\\n","                   * Os[..., _sidx(S, msp), _sidx(S, Mm)] * pref\n","    return ((4 * np.pi / (2 * J + 1)) * 2 * np.pi * np.sum(tot * zw, axis=-1)).real\n","\n","def build_pion_cache():\n","    cache = {wave: [] for wave in UNC_WAVES}\n","    for E_lab in tqdm(ENERGIES, desc='Precomputing pion matrices'):\n","        p_on_shell = np.sqrt(M_NUCLEON * E_lab / 2.0)\n","        p_full = np.append(Q_GRID, p_on_shell)\n","        for wave in UNC_WAVES:\n","            V_pion = calculate_pion_exchanges(p_full, p_full, wave) * regulator(p_full[:, None], p_full[None, :], 3)\n","            cache[wave].append((p_on_shell, V_pion))\n","    return cache\n","\n","PION_CACHE = build_pion_cache()\n","\n","def solve_uncoupled_ls(p_on_shell, V):\n","    # R(p_i,p) = V(p_i,p) + sum_j V(p_i,q_j) D_j R(q_j,p);  tan(delta) = -(pi/2) M p R(p,p) / (2 pi)^3\n","\n","    # matrix method\n","    n_pts = len(Q_GRID)\n","    D = np.empty(n_pts + 1)\n","    D[:n_pts] = W_Q * Q_GRID ** 2 * M_NUCLEON / (p_on_shell ** 2 - Q_GRID ** 2) / TPI3\n","    D[n_pts] = -p_on_shell ** 2 * M_NUCLEON * np.sum(W_Q / (p_on_shell ** 2 - Q_GRID ** 2)) / TPI3\n","    A = np.eye(n_pts + 1) - V * D[None, :]\n","    try:\n","        R = solve(A, V[:, n_pts], assume_a='gen')\n","        return np.degrees(np.arctan(-(np.pi / 2.0) * M_NUCLEON * p_on_shell * R[n_pts] / TPI3))\n","    except np.linalg.LinAlgError:\n","        return 0.0\n","\n","def contact_matrix(wave, lecs, p_full):\n","    p, q = p_full[:, None], p_full[None, :]\n","    if wave == '1S0':\n","        return (lecs['C_tilde_1S0'] * 1e-2 * regulator(p, q, 3) + lecs['C_1S0'] * 1e-8 * (p ** 2 + q ** 2) * regulator(p, q, 2))\n","    if wave == '3S1':\n","        return (lecs['C_tilde_3S1'] * 1e-2 * regulator(p, q, 3) + lecs['C_3S1'] * 1e-8 * (p ** 2 + q ** 2) * regulator(p, q, 2))\n","    return lecs['C_' + wave] * 1e-8 * p * q * regulator(p, q, 2)\n","\n","def wave_phases(wave, lecs):\n","\n","    arc = np.empty(len(ENERGIES))\n","    for E_idx in range(len(ENERGIES)):\n","        p_on_shell, V_pion = PION_CACHE[wave][E_idx]\n","        p_full = np.append(Q_GRID, p_on_shell)\n","        arc[E_idx] = solve_uncoupled_ls(p_on_shell, V_pion + contact_matrix(wave, lecs, p_full))\n","    d = np.degrees(np.unwrap(np.radians(arc), period=np.pi))\n","    if wave == '3S1':\n","        d = d - 180.0 * np.floor((d[0] - 90.0) / 180.0)   # Levinson: deuteron -> delta(0) = 180 deg\n","    else:\n","        d = d - 180.0 * np.round(d[0] / 180.0)\n","    return d[FEAT_IDX]\n","\n","def generate_sample(args):\n","    sample_idx, lecs = args\n","    row = lecs.copy()\n","    for wave in UNC_WAVES:\n","        ph = wave_phases(wave, lecs)\n","        for E_lab, val in zip(FEAT_ENERGIES, ph):\n","            row[f'{wave}_{int(E_lab)}MeV'] = val\n","    return row"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":49,"referenced_widgets":["d0d5f98b226048779176facb2acc0b36","577af68a82044d4181852da8abdc3b4a","dffbb201d1fd4cdfaa9456a1c96ee59e","a345abc5f0b54606b9f0ee3cb475396f","e2631de3bda84daea377f2d540b37af2","33c4662746574a56832762d3b2d25bb7","2656fc958b2e478db7d42e8df418a2a4","c81f320be13246d8a4941b94aac5508a","b891b94646584b0fb9ec279bf1d77766","f23b317fedba40f5a83d8a243968bbf7","86c8ef1621834db3bae6fb49d41c3aac"]},"id":"XQyYyVPrw9Dp","executionInfo":{"status":"ok","timestamp":1792927012780,"user_tz":-330,"elapsed":78013,"user":{"displayName":"GAUTAM BALASUBRAMANIAN 24123013","userId":"06147752629034690759"}},"outputId":"8bbb0c6f-c688-4d9a-a964-93fab26833f3"},"execution_count":null,"outputs":[{"output_type":"display_data","data":{"text/plain":["Precomputing pion matrices:   0%|          | 0/13 [00:00<?, ?it/s]"],"application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"d0d5f98b226048779176facb2acc0b36"}},"metadata":{}}]},{"cell_type":"code","source":["N_TRAIN_SAMPLES = 5000\n","DATA_CSV = f'{TRAIN_DIR}/synthetic_n2lo_literature_units.csv'\n","\n","np.random.seed(SEED)\n","sampled = {name: np.random.uniform(LEC_RANGE[name][0], LEC_RANGE[name][1], N_TRAIN_SAMPLES) for name in LEC_NAMES}\n","tasks = [(i, {name: sampled[name][i] for name in LEC_NAMES}) for i in range(N_TRAIN_SAMPLES)]\n","with mp.Pool(mp.cpu_count()) as pool:\n","    results = list(tqdm(pool.imap(generate_sample, tasks, chunksize=25), total=len(tasks), desc='LS integration'))\n","\n","df_all = pd.DataFrame(results).replace([np.inf, -np.inf], np.nan).dropna().reset_index(drop=True)\n","df_all.to_csv(DATA_CSV, index=False)\n","print(f'Saved dataset of shape {df_all.shape} to {DATA_CSV}')"],"metadata":{"id":"yZIrOD670esC"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["import torch, torch.nn as nn, torch.optim as optim\n","from torch.utils.data import DataLoader, TensorDataset\n","from sklearn.preprocessing import StandardScaler\n","from sklearn.model_selection import train_test_split\n","\n","torch.manual_seed(SEED)\n","X_all, Y_all = df_all[FEAT_COLS].values, df_all[LEC_NAMES].values      # columns selected by name\n","X_train, X_tmp, Y_train, Y_tmp = train_test_split(X_all, Y_all, test_size=0.30, random_state=SEED)\n","X_val, X_test, Y_val, Y_test = train_test_split(X_tmp, Y_tmp, test_size=0.50, random_state=SEED)\n","print(f'train / val / test = {len(X_train)} / {len(X_val)} / {len(X_test)}')\n","\n","# save the splits for the Training_Data / Testing_Data folders\n","for name, X_, Y_, folder in (('train_split', X_train, Y_train, TRAIN_DIR), ('val_split', X_val, Y_val, TRAIN_DIR),\n","                             ('synthetic_heldout_test', X_test, Y_test, TEST_DIR)):\n","    pd.DataFrame(np.hstack([Y_, X_]), columns=LEC_NAMES + FEAT_COLS).to_csv(f'{folder}/{name}.csv', index=False)\n","\n","scaler_X = StandardScaler().fit(X_train)\n","scaler_Y = StandardScaler().fit(Y_train)\n","\n","model = nn.Sequential(nn.Linear(len(FEAT_COLS), 128), nn.ReLU(), nn.Linear(128, 64), nn.ReLU(), nn.Linear(64, 8))\n","criterion = nn.MSELoss()\n","optimizer = optim.Adam(model.parameters(), lr=1e-3, weight_decay=1e-5)\n","loader = DataLoader(TensorDataset(torch.FloatTensor(scaler_X.transform(X_train)),\n","                                  torch.FloatTensor(scaler_Y.transform(Y_train))), batch_size=32, shuffle=True)\n","Xv = torch.FloatTensor(scaler_X.transform(X_val)); Yv = torch.FloatTensor(scaler_Y.transform(Y_val))\n","\n","EPOCHS = 1000\n","train_loss, val_loss = [], []\n","for epoch in tqdm(range(EPOCHS), desc='Training'):\n","    model.train(); tot = 0.0\n","    for bx, by in loader:\n","        optimizer.zero_grad()\n","        loss = criterion(model(bx), by)\n","        loss.backward(); optimizer.step()\n","        tot += loss.item()\n","    train_loss.append(tot / len(loader))\n","    model.eval()\n","    with torch.no_grad():\n","        val_loss.append(criterion(model(Xv), Yv).item())\n","    if (epoch + 1) % 100 == 0:\n","        tqdm.write(f'Ep